{
  "name": "@thestreamcode/dsh-muse-code",
  "version": "0.3.0",
  "description": "Unofficial DeepSeek Harness integration for Meta's Muse Code subscription: declares the shipped Meta provider route and adds its sign-in command. Use at your own risk.",
  "license": "MIT",
  "author": {
    "name": "Michael Gasperini",
    "url": "https://mikesoft.it"
  },
  "homepage": "https://github.com/TheStreamCode/dsh-muse-code",
  "repository": "github:TheStreamCode/dsh-muse-code",
  "bugs": {
    "url": "https://github.com/TheStreamCode/dsh-muse-code/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client/client.js",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "DISCLAIMER.md",
    "AUTH_CONTRACT.md",
    "LICENSE",
    "ADAPTER_CONTRACT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
